<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List Page</title>
</head>
<body>
    <h1>List Page</h1>

    <% if (arr.length > 0) { %>
        <ul>
            <% arr.forEach((ele) => { %>
                <li><%= ele %></li>
            <% }) %>
        </ul>
    <% } else { %>
        <h2>No items</h2>
    <% } %>

</body>
</html>
